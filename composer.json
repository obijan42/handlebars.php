{
    "name": "obijan42/handlebars.php",
    "description": "Handlebars processor for PHP (maintained fork of xamin/handlebars.php)",
    "homepage": "https://github.com/obijan42/handlebars.php",
    "type": "library",
    "keywords": ["handlebars", "mustache", "template", "templating"],
    "license": "MIT",
    "authors": [
        {
            "name": "fzerorubigd",
            "email": "fzerorubigd@gmail.com"
        },
        {
            "name": "Behrooz Shabani (everplays)",
            "email": "everplays@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.2"
    },
    "replace": {
        "xamin/handlebars.php": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9 || ^10 || ^11",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Handlebars\\": "src/Handlebars/"
        }
    }
}
